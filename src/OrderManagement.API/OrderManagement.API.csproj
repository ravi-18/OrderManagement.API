<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.OpenApi" Version="10.0.9" />
    <PackageReference Include="Microsoft.EntityFrameworkCore" Version="10.0.0" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design" Version="10.0.0">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
    <PackageReference Include="Npgsql.EntityFrameworkCore.PostgreSQL" Version="10.0.0" />
    <PackageReference Include="Swashbuckle.AspNetCore" Version="10.0.1" />
    <!-- Security pins: clear transitive advisories. Remove once the parent packages ship fixed dependencies. -->
    <!-- GHSA-v5pm-xwqc-g5wc: pulled in by Swashbuckle and Microsoft.AspNetCore.OpenApi (runtime). -->
    <PackageReference Include="Microsoft.OpenApi" Version="2.7.5" />
    <!-- GHSA-846f-f764-76mx / GHSA-2fmv-rv2c-59x7: pulled in only by EF Core Design (design-time), never shipped. -->
    <PackageReference Include="System.Security.Cryptography.Pkcs" Version="10.0.14">
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
  </ItemGroup>

</Project>
